# GEMINI_API_KEY: Required for Gemini AI API calls.
# In the AI Studio / Cloud Run container preview environment, this key is injected
# as a server-side environment variable via the container runtime settings.
# (For direct Google Cloud Secret Manager integration, the Cloud Run service mounts
# the 'gemini-api-key' secret directly to this environment variable).
# This key is strictly server-side and NEVER exposed to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: Target Firebase project ID for token audience binding.
FIREBASE_PROJECT_ID="true-rampart-464602-i0"
